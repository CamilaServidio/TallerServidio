@{
    ViewData["Title"] = "Turno confirmado";
}

<style>
    body {
        min-height: 100vh;
        background: radial-gradient(circle at top right, rgba(255, 210, 31, 0.38), transparent 32%), radial-gradient(circle at bottom left, rgba(6, 59, 114, 0.28), transparent 38%), linear-gradient(135deg, #dbeaff 0%, #ffffff 52%, #fff4b8 100%);
        background-attachment: fixed;
    }

    .confirmacion {
        max-width: 650px;
        margin: 70px auto;
        padding: 45px 30px;
        text-align: center;
        background: white;
        border-top: 8px solid #ffd21f;
        border-radius: 18px;
        box-shadow: 0 12px 35px rgba(0, 42, 84, 0.15);
    }

    .confirmacion-icono {
        width: 85px;
        height: 85px;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 45px;
        font-weight: bold;
        background: #063b72;
        border-radius: 50%;
    }

    .confirmacion h1 {
        color: #063b72;
        font-weight: 800;
    }

    .confirmacion p {
        color: #425466;
        font-size: 18px;
    }

    .btn-volver {
        display: inline-block;
        margin-top: 15px;
        padding: 12px 25px;
        color: #063b72;
        font-weight: 800;
        text-decoration: none;
        background: #ffd21f;
        border-radius: 10px;
    }

        .btn-volver:hover {
            color: white;
            background: #063b72;
        }
</style>

<div class="confirmacion">
    <div class="confirmacion-icono">✓</div>

    <h1>¡Turno reservado!</h1>

    <p>
        Recibimos correctamente la solicitud para tu vehículo.
    </p>

    <p>
        Te esperamos en <strong>Taller Servidio</strong>.<br />
        Nuestro horario es de lunes a viernes, de 8:30 a 19:00.
    </p>

    <a asp-controller="Turnos"
       asp-action="Crear"
       class="btn-volver">
        Reservar otro turno
    </a>
</div>