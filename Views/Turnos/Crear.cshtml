@model TallerServidio.Models.ReservaTurnoViewModel

@{
    ViewData["Title"] = "Reservar turno";
}

<style>
    body {
        

        min-height: 100vh;
        background: radial-gradient(circle at top right, rgba(255, 210, 31, 0.38), transparent 32%), radial-gradient(circle at bottom left, rgba(6, 59, 114, 0.28), transparent 38%), linear-gradient(135deg, #dbeaff 0%, #ffffff 52%, #fff4b8 100%);
        background-attachment: fixed;
    }
    

    .turno-contenedor {
        max-width: 780px;
        margin: 35px auto;
    }

    .turno-encabezado {
        padding: 32px;
        color: white;
        text-align: center;
        background: #063b72;
        border-bottom: 6px solid #ffd21f;
        border-radius: 18px 18px 0 0;
    }

    .turno-encabezado h1 {
        margin: 0 0 8px;
        font-weight: 800;
    }

    .turno-formulario {
        padding: 30px;
        background: white;
        border-radius: 0 0 18px 18px;
        box-shadow: 0 12px 35px rgba(0, 42, 84, 0.15);
    }

    .form-label {
        color: #063b72;
        font-weight: 700;
    }

    .form-control:focus {
        border-color: #f1bd00;
        box-shadow: 0 0 0 0.2rem rgba(255, 210, 31, 0.25);
    }

    .btn-reservar {
        width: 100%;
        padding: 13px;
        color: #063b72;
        font-size: 18px;
        font-weight: 800;
        background: #ffd21f;
        border: none;
        border-radius: 10px;
    }

    .btn-reservar:hover {
        color: white;
        background: #063b72;
    }

    .informacion {
        margin-bottom: 25px;
        padding: 15px;
        color: #063b72;
        background: #fff7cf;
        border-left: 5px solid #ffd21f;
        border-radius: 8px;
    }

    .text-danger {
        font-size: 14px;
    }
</style>

<div class="turno-contenedor">
    <div class="turno-encabezado">
        <h1>Taller Servidio</h1>
        <p class="mb-0">Reservá el turno para tu vehículo</p>
    </div>

    <div class="turno-formulario">
        <div class="informacion">
            <strong>Horario del taller:</strong> lunes a viernes de 8:30 a 19:00.<br />
            Recibimos un máximo de dos vehículos por día. Los vehículos se entregan preferentemente al abrir.
        </div>

        <form asp-controller="Turnos" asp-action="Crear" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Fecha" class="form-label"></label>
                <input asp-for="Fecha"
                       class="form-control"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="Fecha" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Apellido" class="form-label"></label>
                    <input asp-for="Apellido" class="form-control" />
                    <span asp-validation-for="Apellido" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Telefono" class="form-label"></label>
                <input asp-for="Telefono" class="form-control" />
                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ModeloAuto" class="form-label"></label>
                    <input asp-for="ModeloAuto" class="form-control"
                           placeholder="Ej.: Peugeot 208" />
                    <span asp-validation-for="ModeloAuto" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="AnioAuto" class="form-label"></label>
                    <input asp-for="AnioAuto" class="form-control"
                           placeholder="Ej.: 2021" />
                    <span asp-validation-for="AnioAuto" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Patente" class="form-label"></label>
                <input asp-for="Patente" class="form-control"
                       placeholder="Ej.: AB123CD" />
                <span asp-validation-for="Patente" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="TrabajoSolicitado" class="form-label"></label>
                <textarea asp-for="TrabajoSolicitado"
                          class="form-control"
                          rows="4"
                          placeholder="Contanos brevemente qué necesita el vehículo"></textarea>
                <span asp-validation-for="TrabajoSolicitado" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-reservar">
                Reservar turno
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const fechaInput = document.getElementById("Fecha");
            const mensajeError =
                document.querySelector('[data-valmsg-for="Fecha"]');

            fechaInput.addEventListener("change", function () {
                if (!this.value) return;

                const partes = this.value.split("-");
                const fecha = new Date(
                    Number(partes[0]),
                    Number(partes[1]) - 1,
                    Number(partes[2])
                );

                const dia = fecha.getDay();

                if (dia === 0 || dia === 6) {
                    this.value = "";
                    mensajeError.textContent =
                        "El taller no toma turnos los sábados ni domingos.";
                    mensajeError.classList.add("field-validation-error");
                } else {
                    mensajeError.textContent = "";
                }
            });
        });
    </script>
}